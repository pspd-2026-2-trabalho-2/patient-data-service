# ---- patient-data-service: variáveis de ambiente ----
# Copie para .env e ajuste conforme necessário.

# Porta do servidor gRPC
GRPC_PORT=50051

# Porta do servidor HTTP de métricas Prometheus + health check
METRICS_PORT=9090

# ----- Conexão com o Postgres (DATABASE_URL tem prioridade) -----
# Usamos o formato "keyword/value" do pgx (aceito pelo ParseConfig): ele lida com
# senhas que contêm caracteres especiais como '@' sem precisar de percent-encoding.

# (1) Postgres LOCAL de exemplo (docker compose up -d db, porta 5433 no host):
DATABASE_URL="host=localhost port=5433 user=pspd password=pspd dbname=hospital sslmode=disable"

# (2) Banco REAL do professor (ex.: Grupo 3 = pseudopep_g03) via TÚNEL SSH local.
#     Abra o túnel antes de rodar o serviço:
#       ssh -p 10200 -L 15432:192.168.122.1:5432 a<sua_matricula>@kiriland.unb.br
# DATABASE_URL="host=localhost port=15432 user=grupo03_user password=123@g03 dbname=pseudopep_g03 sslmode=disable"

# (3) Banco REAL dentro do cluster K8S (host da rede interna, sem túnel):
# DATABASE_URL="host=192.168.122.1 port=5432 user=grupo03_user password=123@g03 dbname=pseudopep_g03 sslmode=disable"

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
