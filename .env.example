# ---- patient-data-service: variáveis de ambiente ----
# Copie para .env e ajuste conforme necessário.

# Porta do servidor gRPC
GRPC_PORT=50051

# Porta do servidor HTTP de métricas Prometheus + health check
METRICS_PORT=9090

# Conexão com o Postgres.
# Opção A (recomendada): DATABASE_URL completa (tem prioridade se preenchida).
# O docker-compose expõe o Postgres local na porta 5433 do host (ver docker-compose.yml).
DATABASE_URL=postgres://pspd:pspd@localhost:5433/hospital?sslmode=disable

# Opção B: variáveis separadas (usadas se DATABASE_URL estiver vazia).
PGHOST=localhost
PGPORT=5433
PGUSER=pspd
PGPASSWORD=pspd
PGDATABASE=hospital
PGSSLMODE=disable

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
